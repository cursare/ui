{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "cursare",
  "homepage": "https://cursare.github.io/ui/",
  "items": [
    {
      "name": "date-picker",
      "type": "registry:ui",
      "title": "Date Picker",
      "description": "Localized date picker with ISO date-string values.",
      "dependencies": [
        "@daypicker/react@10.0.1",
        "lucide-react@^1.28.0"
      ],
      "registryDependencies": [
        "@coss/button",
        "@coss/calendar",
        "@coss/popover"
      ],
      "files": [
        {
          "path": "registry/ui/date-picker.tsx",
          "type": "registry:ui",
          "target": "@ui/date-picker.tsx"
        }
      ]
    },
    {
      "name": "date-range-picker",
      "type": "registry:ui",
      "title": "Date Range Picker",
      "description": "Localized date-range picker with presets and bounded ranges.",
      "dependencies": [
        "@daypicker/react@10.0.1",
        "lucide-react@^1.28.0"
      ],
      "registryDependencies": [
        "@coss/button",
        "@coss/calendar",
        "@coss/popover",
        "cursare/ui/date-picker"
      ],
      "files": [
        {
          "path": "registry/ui/date-range-picker.tsx",
          "type": "registry:ui",
          "target": "@ui/date-range-picker.tsx"
        }
      ]
    },
    {
      "name": "phone-input",
      "type": "registry:ui",
      "title": "Phone Input",
      "description": "International phone input with localized country selection.",
      "dependencies": [
        "libphonenumber-js@1.13.11",
        "lucide-react@^1.28.0"
      ],
      "registryDependencies": [
        "@coss/input",
        "@coss/popover"
      ],
      "files": [
        {
          "path": "registry/ui/phone-input.tsx",
          "type": "registry:ui",
          "target": "@ui/phone-input.tsx"
        }
      ]
    },
    {
      "name": "settings-toggle",
      "type": "registry:ui",
      "title": "Settings Toggle",
      "description": "Immediate-save settings row with loading state.",
      "registryDependencies": [
        "@coss/frame",
        "@coss/skeleton",
        "@coss/switch"
      ],
      "files": [
        {
          "path": "registry/ui/settings-toggle.tsx",
          "type": "registry:ui",
          "target": "@ui/settings-toggle.tsx"
        }
      ]
    },
    {
      "name": "use-media-query",
      "type": "registry:hook",
      "title": "Use Media Query",
      "description": "SSR-safe responsive media-query hook.",
      "files": [
        {
          "path": "registry/hooks/use-media-query.ts",
          "type": "registry:hook",
          "target": "@hooks/use-media-query.ts"
        }
      ]
    },
    {
      "name": "ui",
      "type": "registry:item",
      "title": "Cursare UI",
      "description": "The complete Cursare extension set for COSS UI.",
      "registryDependencies": [
        "@coss/style",
        "cursare/ui/date-picker",
        "cursare/ui/date-range-picker",
        "cursare/ui/phone-input",
        "cursare/ui/settings-toggle",
        "cursare/ui/use-media-query"
      ],
      "docs": "Installs Cursare's composed components while resolving primitives from the official COSS registry."
    }
  ]
}
