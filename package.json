{
  "name": "@cursare/learner-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Public source registry for Cursare learner-facing surfaces.",
  "type": "module",
  "license": "MIT",
  "author": "Cursare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cursare/ui.git"
  },
  "homepage": "https://cursare.github.io/ui/",
